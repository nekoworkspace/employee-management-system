@model Employee_management_system1.Models.Employee

<h2>社員削除</h2>

<p>本当に削除しますか？</p>

<form asp-action="Delete" method="post">

    <input type="hidden" asp-for="Id" />

    <p>ID : @Model.Id</p>

    <p>氏名 : @Model.Name</p>

    <p>部署 : @Model.Department</p>

    <button type="submit">
        削除
    </button>

</form>